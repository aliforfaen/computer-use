# Reference only: most CLI/service processes do not automatically load the root
# .env. Export chosen values into the process that runs the probe/daemon; scripts
# that load .env document that behavior in their own help.
# Jev selector API calls are disabled unless this is explicitly set true.
# This flag controls provider calls only; the selector is not wired into the daemon.
JEV_ENABLED=false

# Provider credentials: put values in private files, never commit them here.
# Jev probe: ~/.config/jev-desktop/jev.env (0600)
# JEV_API_KEY=
# Vision reader: ~/.config/jev-desktop/daemon.env (0600)
# DEEPSEEK_API_KEY=
# MIMO_API_KEY=

# Optional local daemon overrides. The application also accepts these as CLI
# options or in its private JSON configuration where documented.
# JEV_DESKTOP_SOCKET=
# JEV_DESKTOP_CONFIG=
# JEV_DESKTOP_ALLOW_APPS=
# JEV_DESKTOP_ICON=
# JEV_DESKTOP_DESKTOP_ENTRY=
